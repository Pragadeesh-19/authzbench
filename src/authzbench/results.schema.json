{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AuthzBench results",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "engine", "dataset", "environment", "conformance", "driver_baseline", "modes"],
  "properties": {
    "format": {"const": "authzbench.results/1"},
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model", "scale", "seed", "relationships", "checks"],
      "properties": {
        "model": {"type": "string", "minLength": 1},
        "scale": {"enum": ["S", "M", "L"]},
        "seed": {"type": "integer"},
        "relationships": {"type": "integer", "minimum": 0},
        "checks": {"type": "integer", "minimum": 0}
      }
    },
    "environment": {
      "type": "object",
      "required": ["recorded_at"],
      "properties": {
        "recorded_at": {"type": "string", "format": "date-time"}
      }
    },
    "conformance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checks", "mismatches"],
      "properties": {
        "checks": {"type": "integer", "minimum": 1},
        "mismatches": {"const": 0}
      }
    },
    "driver_baseline": {
      "type": "array",
      "items": {"$ref": "#/$defs/open_loop"}
    },
    "modes": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/mode"}
    }
  },
  "$defs": {
    "nanoseconds": {"type": "integer", "minimum": 0},
    "latency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "p50_ns", "p99_ns", "p999_ns", "max_ns"],
      "properties": {
        "count": {"type": "integer", "minimum": 1},
        "p50_ns": {"$ref": "#/$defs/nanoseconds"},
        "p99_ns": {"$ref": "#/$defs/nanoseconds"},
        "p999_ns": {"$ref": "#/$defs/nanoseconds"},
        "max_ns": {"$ref": "#/$defs/nanoseconds"}
      }
    },
    "open_loop": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rate_per_second", "in_flight", "latency", "schedule_lag"],
      "properties": {
        "rate_per_second": {"type": "integer", "minimum": 1},
        "in_flight": {"type": "integer", "minimum": 1},
        "latency": {"$ref": "#/$defs/latency"},
        "schedule_lag": {"$ref": "#/$defs/latency"}
      }
    },
    "mode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["consistency", "mode", "service_time", "open_loop", "revocation"],
      "properties": {
        "consistency": {"enum": ["fresh", "fastest"]},
        "mode": {"type": "string", "minLength": 1},
        "service_time": {"$ref": "#/$defs/latency"},
        "open_loop": {
          "type": "array",
          "items": {"$ref": "#/$defs/open_loop"}
        },
        "revocation": {
          "type": "object",
          "additionalProperties": false,
          "required": ["placement", "staleness_ns", "resolution_ns", "denied_by_ns", "write_ns", "cap_ns"],
          "properties": {
            "placement": {"enum": ["in_process", "same_machine", "second_machine"]},
            "staleness_ns": {"oneOf": [{"$ref": "#/$defs/nanoseconds"}, {"type": "null"}]},
            "resolution_ns": {"$ref": "#/$defs/nanoseconds"},
            "denied_by_ns": {"oneOf": [{"$ref": "#/$defs/nanoseconds"}, {"type": "null"}]},
            "write_ns": {"$ref": "#/$defs/nanoseconds"},
            "cap_ns": {"type": "integer", "minimum": 1}
          }
        }
      }
    }
  }
}
